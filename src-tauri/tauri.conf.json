{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.1.0",
  "identifier": "com.juandiego.companion",
  "build": {
    "frontendDist": "../plugins"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Companion"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": {
      "../plugins": "plugins"
    },
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
